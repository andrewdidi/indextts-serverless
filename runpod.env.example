VOLUME_ROOT=/runpod-volume
DOWNLOAD_MODELS_ON_START=0
REQUIRE_MODELS=1
MODEL_VERSION=2.5
USE_BF16=1
USE_FP16=1
USE_CUDA_KERNEL=0
USE_QWEN_EMO=0
TURBO=1
PRELOAD_MODEL=1
HF_HUB_ENABLE_HF_TRANSFER=1
# HF_TOKEN=hf_xxx
# 关闭极速：TURBO=0
# BigVGAN 自定义核需 nvcc（devel 镜像）；slim 保持 0，否则冷启动会打印 Falling back to torch
# 文本情感：USE_QWEN_EMO=1（需 Redeploy 预热）
